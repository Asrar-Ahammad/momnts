# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/momnts"

# ─── Auth (Legacy JWT) ──────────────────────────────────────────────
JWT_SECRET="generate-a-random-64-char-hex-string"
CHAT_ENCRYPTION_SECRET="generate-a-random-64-char-hex-string"
AUTH_REFRESH_SECRET="generate-a-random-64-char-hex-string"
AUTH_SECRET_EXPIRES_IN="15m"
AUTH_REFRESH_SECRET_EXPIRES_IN="24h"

# ─── Server ─────────────────────────────────────────────────────────
APP_HOST=localhost
APP_PORT=3000
CLIENT_APP_URL="http://localhost:5173"
NODE_ENV="development"

# ─── Python Vision Service ──────────────────────────────────────────
PYTHON_SERVICE_URL="http://localhost:8000"

# ─── Cloudflare R2 Storage ──────────────────────────────────────────
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME=momnts-photos
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"
R2_ENDPOINT_URL="https://your-account-id.r2.cloudflarestorage.com"

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"

# ─── Email (SMTP fallback) ─────────────────────────────────────────
SMTP_EMAIL="your-email@example.com"
SMTP_APP_PASSWORD="your-smtp-app-password"

# ─── Cloudflare Turnstile ──────────────────────────────────────────
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# ─── Clerk Auth (Feature 2) ────────────────────────────────────────
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"
CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key"
CLERK_WEBHOOK_SECRET="whsec_your-clerk-webhook-secret"

# ─── Sparkage Email Service ─────────────────────────────────────────
SPARKAGE_PUBLIC_API_KEY="your-sparkage-public-api-key"
SPARKAGE_SECRET_API_KEY="your-sparkage-secret-api-key"

